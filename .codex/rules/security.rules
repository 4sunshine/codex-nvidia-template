# Project-level guardrails supplement Git hooks and remote branch protection.

prefix_rule(
    pattern = [
        "git",
        "push",
        [
            "--force",
            "-f",
            "--force-with-lease",
            "--mirror",
            "--delete",
            "-d",
        ],
    ],
    decision = "forbidden",
    justification = "History rewriting and remote branch deletion remain prohibited.",
    match = [
        "git push --force origin agent/example",
        "git push --force-with-lease origin agent/example",
        "git push --delete origin agent/example",
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Preserve local work and use a non-destructive recovery path.",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "git clean can destroy untracked user files.",
    match = ["git clean -fd", "git clean -fdx"],
)

prefix_rule(
    pattern = [
        "git",
        [
            "add",
            "commit",
            "fetch",
            "pull",
            "push",
        ],
    ],
    decision = "allow",
    justification = "Normal Git development and publication are autonomous on agent branches.",
    match = [
        "git add README.md",
        "git commit -m update",
        "git fetch origin",
        "git pull --ff-only origin agent/example",
        "git push -u origin agent/example",
    ],
)
